+def _demand_rollup_select(active_download_demand_ids: list[int] | None = None) -> str:
+    """取出 demand_rollups CTE 的纯 SELECT 体（去掉 CTE 头与收尾括号）。"""
+    cte = _library_demand_rollups_cte(active_download_demand_ids)
+    prefix = "demand_rollups AS MATERIALIZED ("
+    body = cte[len(prefix):].strip() if cte.startswith(prefix) else cte
+    if body.endswith(")"):
+        body = body[:-1]
+    return body.rstrip()
+
+
+def _materialize_demand_rollup(
+    connection: Connection, active_download_demand_ids: list[int] | None = None
+) -> None:
+    """把订阅需求聚合成带索引的临时表 dr_rollup。
+
+    CTE 没有统计信息时规划器会把估算塌成 1 行并选嵌套循环，内层每轮都要整段
+    重扫（实测 16643 轮 x 9705 行）。落成有索引的临时表后，同样的嵌套循环变成
+    按键查找，主查询也可走 hash join。
+    """
+    select_sql = _demand_rollup_select(active_download_demand_ids)
+    connection.execute("DROP TABLE IF EXISTS pg_temp.dr_rollup")
+    connection.execute(f"CREATE TEMP TABLE dr_rollup ON COMMIT DROP AS {select_sql}")
+    connection.execute(
+        "CREATE INDEX ON dr_rollup (provider, entity_type, media_external_id, season_key)"
+    )
+    connection.execute("ANALYZE dr_rollup")
+
+
+def _materialize_season_episode_flags(connection: Connection) -> None:
+    """把"每季是否已有在库集"预聚合成带索引的临时表 se_flags。
+
+    原写法是 season_candidates 里的相关子查询 EXISTS(...)，每季执行一次
+    （实测 16643 次 x 每次约 0.34ms 约合 5.6 秒，单次逻辑读 127557 页）。改成
+    一次性 GROUP BY 聚合加索引后，同样的判断退化为一次索引探测。
+    """
+    connection.execute("DROP TABLE IF EXISTS pg_temp.se_flags")
+    connection.execute(
+        """
+        CREATE TEMP TABLE se_flags ON COMMIT DROP AS
+        SELECT episode.parent_id AS season_item_id, TRUE AS has_current_version
+        FROM media.items episode
+        JOIN media.item_versions version
+          ON version.item_id = episode.id
+         AND version.is_current
+        WHERE episode.item_type = 'episode'
+          AND episode.is_active
+          AND episode.parent_id IS NOT NULL
+        GROUP BY episode.parent_id
+        """
+    )
+    connection.execute("CREATE INDEX ON se_flags (season_item_id)")
+    connection.execute("ANALYZE se_flags")
+
+
+def _materialize_library_demand_index(connection: Connection) -> None:
+    """把「条目 -> 订阅诉求」映射预聚合成一张按 item_id 建索引的临时表。
+
+    原始 SQL 用 provider/entity_type/外部ID/season_key 的多表达式等值把季与
+    订阅滚档连起来，季这一侧键要先从 metadata payload 里解析季号再做 COALESCE，
+    规划器无法用索引，只能对每个季重复求值，一次列表接口里要跑上万轮。
+    这里先把季号解析一次落成 season_keys，再与 dr_rollup 连成
+    dm_by_item(item_id, has_active_request, source_types)，三处调用点都退化成
+    单列整数等值 join。
+    """
+    connection.execute("""
+        CREATE TEMP TABLE season_keys ON COMMIT DROP AS
+        SELECT s.id AS season_item_id,
+               se_series.external_id AS media_external_id,
+               coalesce(
+                   NULLIF(substring(se.external_id FROM ':S([0-9]+)$'), '')::integer,
+                   CASE
+                       WHEN coalesce(snap.payload ->> 'season_number', '') ~ '^[0-9]+$'
+                       THEN (snap.payload ->> 'season_number')::integer
+                   END,
+                   -1
+               ) AS season_key
+          FROM media.items s
+          JOIN media.items series
+            ON series.id = s.parent_id
+           AND series.is_active
+           AND series.item_type = 'series'
+          JOIN media.external_ids se_series
+            ON se_series.item_id = series.id
+           AND se_series.provider = 'tmdb'
+           AND se_series.entity_type = 'series'
+          JOIN media.external_ids se
+            ON se.item_id = s.id
+           AND se.provider = 'tmdb'
+           AND se.entity_type = 'season'
+          LEFT JOIN media.item_metadata snap
+            ON snap.item_id = s.id AND snap.is_current
+         WHERE s.is_active
+           AND s.item_type = 'season'
+        """
+    )
+    connection.execute("CREATE INDEX ON season_keys (season_item_id)")
+    connection.execute("ANALYZE season_keys")
+    # 两张小表的 hash join 更稳，避免规划器因行数估算偏低退回嵌套循环。
+    connection.execute("SET LOCAL enable_nestloop = off")
+    try:
+        connection.execute("""
+            CREATE TEMP TABLE dm_by_item ON COMMIT DROP AS
+            SELECT k.season_item_id AS item_id,
+                   dr.has_active_request,
+                   dr.source_types
+              FROM season_keys k
+              JOIN dr_rollup dr
+                ON dr.provider = 'tmdb'
+               AND dr.entity_type = 'season'
+               AND dr.media_external_id = k.media_external_id
+               AND dr.season_key = k.season_key
+            UNION ALL
+            SELECT item.id AS item_id,
+                   dr.has_active_request,
+                   dr.source_types
+              FROM media.items item
+              JOIN media.external_ids ext
+                ON ext.item_id = item.id
+               AND ext.provider = 'tmdb'
+               AND ext.entity_type = 'movie'
+              JOIN dr_rollup dr
+                ON dr.provider = 'tmdb'
+               AND dr.entity_type = 'movie'
+               AND dr.media_external_id = ext.external_id
+               AND dr.season_key = -1
+             WHERE item.item_type = 'movie'
+               AND item.is_active
+            """
+        )
+    finally:
+        connection.execute("SET LOCAL enable_nestloop = on")
+    connection.execute("CREATE UNIQUE INDEX ON dm_by_item (item_id)")
+    connection.execute("ANALYZE dm_by_item")
+
+
+
+def _materialize_library_media_meta(connection: Connection) -> None:
+    """把列表接口要用的 metadata payload 字段预解成三张小表。
+
+    media.item_metadata.payload 是 jsonb，季 payload 平均 2.3KB、最大 1.1MB，实际
+    落在 TOAST 里。列表主体每行都要取 name/poster_path/season_number，等于逐行去
+    解 TOAST：fulfilled 列表单是 season 主体投影就 4.2 秒，且同一 payload 被投影
+    两次（context_json 一次、poster_path 一次）。这里先把 payload 展开成
+    series_meta / season_meta / movie_meta 三张带主键的临时表，列表主体退化成整数
+    等值 join，实测 season 主体 4.23s -> 0.18s。
+    """
+    connection.execute("""
+        CREATE TEMP TABLE series_meta ON COMMIT DROP AS
+        SELECT series.id AS series_id,
+               nullif(meta.payload ->> 'poster_path', '') AS poster_path,
+               nullif(meta.payload ->> 'name', '') AS name
+          FROM media.items series
+          LEFT JOIN media.item_metadata meta
+            ON meta.item_id = series.id AND meta.is_current
+         WHERE series.is_active AND series.item_type = 'series'
+    """)
+    connection.execute("CREATE UNIQUE INDEX ON series_meta (series_id)")
+    connection.execute("""
+        CREATE TEMP TABLE season_meta ON COMMIT DROP AS
+        SELECT season.id AS season_item_id,
+               COALESCE(
+                   NULLIF(substring(ext.external_id FROM ':S([0-9]+)$'), '')::integer,
+                   CASE
+                       WHEN coalesce(meta.payload ->> 'season_number', '') ~ '^[0-9]+$'
+                       THEN (meta.payload ->> 'season_number')::integer
+                   END
+               ) AS season_number,
+               COALESCE(series.poster_path, nullif(meta.payload ->> 'poster_path', '')) AS poster_path
+          FROM media.items season
+          LEFT JOIN media.external_ids ext
+            ON ext.item_id = season.id
+           AND ext.provider = 'tmdb'
+           AND ext.entity_type = 'season'
+          LEFT JOIN series_meta series ON series.series_id = season.parent_id
+          LEFT JOIN media.item_metadata meta
+            ON meta.item_id = season.id AND meta.is_current
+         WHERE season.is_active AND season.item_type = 'season'
+    """)
+    connection.execute("CREATE UNIQUE INDEX ON season_meta (season_item_id)")
+    connection.execute("""
+        CREATE TEMP TABLE movie_meta ON COMMIT DROP AS
+        SELECT item.id AS movie_item_id,
+               nullif(meta.payload ->> 'poster_path', '') AS poster_path,
+               nullif(meta.payload ->> 'year', '') AS year,
+               nullif(meta.payload ->> 'release_date', '') AS release_date
+          FROM media.items item
+          JOIN media.external_ids ext
+            ON ext.item_id = item.id
+           AND ext.provider = 'tmdb'
+           AND ext.entity_type = 'movie'
+          LEFT JOIN media.item_metadata meta
+            ON meta.item_id = item.id AND meta.is_current
+         WHERE item.item_type = 'movie' AND item.is_active
+    """)
+    connection.execute("CREATE UNIQUE INDEX ON movie_meta (movie_item_id)")
+    connection.execute("ANALYZE series_meta")
+    connection.execute("ANALYZE season_meta")
+    connection.execute("ANALYZE movie_meta")
+
